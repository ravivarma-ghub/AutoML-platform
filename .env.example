# =============================================================================
# Intelligent AutoML Platform — Environment Variables Template
# Copy this file to .env and fill in the values:  cp .env.example .env
# NEVER commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Intelligent AutoML Platform
DEBUG=false
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# API Server (FastAPI / Uvicorn)
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000

# Allowed CORS origins — JSON array of strings
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# ---------------------------------------------------------------------------
# Streamlit UI
# ---------------------------------------------------------------------------
STREAMLIT_PORT=8501
# URL that Streamlit uses to call the API (inside docker network: http://api:8000)
API_BASE_URL=http://api:8000

# ---------------------------------------------------------------------------
# PostgreSQL Database
# ---------------------------------------------------------------------------
POSTGRES_USER=automl
POSTGRES_PASSWORD=automl
POSTGRES_DB=automl
POSTGRES_PORT=5432
DATABASE_URL=postgresql://automl:automl@db:5432/automl

# For local development (outside Docker), override to:
# DATABASE_URL=postgresql://automl:automl@localhost:5432/automl

# ---------------------------------------------------------------------------
# MLflow Tracking Server
# ---------------------------------------------------------------------------
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000

# For local development (outside Docker), override to:
# MLFLOW_TRACKING_URI=http://localhost:5000

# MLflow S3 / artifact store (optional — leave blank to use local filesystem)
# MLFLOW_S3_ENDPOINT_URL=https://s3.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://your-bucket/mlruns

# ---------------------------------------------------------------------------
# File System Paths (inside container)
# ---------------------------------------------------------------------------
MODEL_REGISTRY_PATH=/app/models
REPORTS_PATH=/app/reports
LOGS_PATH=/app/logs

# ---------------------------------------------------------------------------
# AutoML / Training Configuration
# ---------------------------------------------------------------------------
MAX_TRAINING_TIME_SECS=3600
N_TRIALS=50
CV_FOLDS=5
RANDOM_SEED=42
N_JOBS=-1

# ---------------------------------------------------------------------------
# Security / Auth (placeholder — wire up when adding authentication)
# ---------------------------------------------------------------------------
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
# LOG_LEVEL=INFO
